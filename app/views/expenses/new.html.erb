<h2>出費を記録する</h2>

<%= form_with(model: @expense, local: true) do |form| %>
  <% if @expense.errors.any? %>
    <div style="color: red;">
      <h3>エラーが発生したため保存できませんでした：</h3>
      <ul>
        <% @expense.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :currency_id, "通貨" %><br>
    <%= form.collection_select :currency_id, Currency.all, :id, :code, { prompt: "通貨を選択してください" }, { required: true } %>
  </div>

  <br>

  <div>
    <%= form.label :amount, "金額" %><br>
    <%= form.number_field :amount, step: "0.01", required: true %>
  </div>

  <br>

  <div>
    <%= form.label :description, "内容 (メモ)" %><br>
    <%= form.text_field :description, placeholder: "例: 昼食代、コンビニ" %>
  </div>

  <br>

  <div>
    <%= form.label :recorded_at, "日付" %><br>
    <% default_date = params[:month].present? ? Date.parse("#{params[:month]}-01") : Time.zone.today %>
    <%= form.date_field :recorded_at, value: default_date, required: true %>
  </div>

  <br>

  <div>
    <%= form.submit "記録する" %>
  </div>
<% end %>

<br>
<%= link_to '一覧に戻る', expenses_path %>