<h2>出費一覧</h2>

<% 
  # 表示中の月から、前月と次月の文字列（"2026-05" など）を計算
  current_date = Date.parse("#{@selected_month}-01")
  prev_month = (current_date - 1.month).strftime("%Y-%m")
  next_month = (current_date + 1.month).strftime("%Y-%m")
%>

<div style="margin: 20px 0; font-size: 1.2em; display: flex; gap: 20px; align-items: center;">
  <%= link_to '◀ 前の月', expenses_path(month: prev_month), style: "text-decoration: none;" %>
  <span style="font-weight: bold; font-size: 1.3em;"><%= current_date.strftime("%Y年 %m月") %></span>
  <%= link_to '次の月 ▶', expenses_path(month: next_month), style: "text-decoration: none;" %>
</div>

<p>こんにちは、<%= current_user.email %> さん</p>
<%= link_to 'ログアウト', destroy_user_session_path, data: { turbo_method: :delete } %>

<hr>


<%= link_to '＋ 新しい出費を記録する', new_expense_path, style: "font-weight: bold; font-size: 1.2em;" %>

<br><br>

<table border="1" style="border-collapse: collapse; width: 100%; text-align: left;">
  <thead>
    <tr style="background-color: #f2f2f2;">
      <th style="padding: 8px;">日付</th>
      <th style="padding: 8px;">金額</th>
      <th style="padding: 8px;">内容 (メモ)</th>
    </tr>
  </thead>
  <tbody>
    <% @expenses.each do |expense| %>
      <tr>
        <td style="padding: 8px;"><%= expense.recorded_at %></td>
        <td style="padding: 8px;">
          <%= expense.currency.symbol %><%= number_with_delimiter(expense.amount) %>
        </td>
        <td style="padding: 8px;"><%= expense.description %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @expenses.empty? %>
  <p>まだ出費の記録はありません。</p>
<% end %>
<div style="
  position: fixed;
  bottom: 20px;
  right: 20px;
  background-color: #ffffff;
  border: 2px solid #333333;
  border-radius: 8px;
  padding: 15px;
  box-shadow: 0 4px 6px rgba(0,0,0,0.1);
  max-width: 250px;
  min-width: 180px;
  z-index: 1000;
">
  <h3 style="margin-top: 0; margin-bottom: 10px; border-bottom: 1px solid #ccc; padding-bottom: 5px; font-size: 1em; color: #555;">
    <%= Date.parse("#{@selected_month}-01").strftime("%m月") %>の合計出費
  </h3>

  <ul style="list-style: none; padding: 0; margin: 0; font-size: 1.2em; font-weight: bold;">
    <% if @totals_by_currency.empty? %>
      <li style="color: #999; font-size: 0.9em; font-weight: normal;">記録がありません</li>
    <% else %>
      <% @totals_by_currency.each do |currency_id, total_amount| %>
        <% 
          # 通貨IDから、通貨の情報（記号など）を取得
          currency = Currency.find(currency_id) 
        %>
        <li style="margin-bottom: 5px; display: flex; justify-content: space-between;">
          <span><%= currency.code %>:</span>
          <span style="color: #2c3e50;">
            <%= currency.symbol %><%= number_with_delimiter(total_amount) %>
          </span>
        </li>
      <% end %>
    <% end %>

    <li style="margin-top: 10px; padding-top: 10px; border-top: 2px dashed #333333; display: flex; justify-content: space-between; color: #e74c3c;">
    <%= "Total in JPY: ¥#{number_with_delimiter(sprintf("%.2f", @total_jpy))}" %>
    </li>
</ul>
</div>

<div style="
  position: fixed;
  bottom: 20px;
  left: 20px;
  background-color: #f9f9f9;
  border: 1px solid #dddddd;
  border-radius: 8px;
  padding: 15px;
  box-shadow: 0 4px 6px rgba(0,0,0,0.05);
  font-size: 0.9em;
  color: #333333;
  min-width: 160px;
  z-index: 1000;
">
  <h4 style="margin-top: 0; margin-bottom: 8px; border-bottom: 1px solid #e0e0e0; padding-bottom: 5px; font-size: 0.95em; color: #666;">
    現在の為替レート (対円)
  </h4>
  <table style="width: 100%; border-collapse: collapse; font-weight: bold; font-size: 1.05em;">
    <tr style="height: 24px;">
      <td style="color: #7f8c8d;">1 USD (ドル):</td>
      <td style="text-align: right; color: #e74c3c;">¥<%= @rates[:usd] %></td>
    </tr>
    <tr style="height: 24px;">
      <td style="color: #7f8c8d;">1 EUR (ユーロ):</td>
      <td style="text-align: right; color: #2980b9;">¥<%= @rates[:eur] %></td>
    </tr>
    <tr style="height: 24px;">
      <td style="color: #7f8c8d;">1 GBP (ポンド):</td>
      <td style="text-align: right; color: #27ae60;">¥<%= @rates[:gbp] %></td>
    </tr>
  </table>
</div>