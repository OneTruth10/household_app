<div style="max-width: 600px; margin: 40px auto; padding: 20px; font-family: sans-serif;">
  <div style="background: white; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.05); padding: 30px; text-align: center;">
    
    <div style="margin-bottom: 20px;">
      <% if @user.avatar.attached? %>
        <%= image_tag @user.avatar, style: "width: 100px; height: 100px; border-radius: 50%; object-fit: cover; border: 3px solid #764ba2;" %>
      <% else %>
        <div style="width: 100px; height: 100px; border-radius: 50%; background: #e2e8f0; display: flex; align-items: center; justify-content: center; color: #718096; font-size: 2.5em; font-weight: bold; margin: 0 auto;">
          <%= @user.display_name.present? ? @user.display_name[0].upcase : "U" %>
        </div>
      <% end %>
    </div>

    <% # 💡 名前が空（nil）の場合でも、'No Name' と安全に表示されるように対策します %>
    <h2 style="color: #2d3748; margin: 10px 0 5px 0;"><%= @user.display_name.presence || "No Name" %></h2>
    <p style="color: #718096; font-size: 0.95em; margin-bottom: 25px;"><%= @user.email %></p>

    <hr style="border: none; border-top: 1px solid #edf2f7; margin-bottom: 25px;">

    <div style="display: flex; justify-content: center; gap: 15px;">
      <% if current_user == @user %>
        <%= link_to 'プロフィールを編集', edit_user_registration_path, style: "background: #764ba2; color: white; padding: 10px 24px; border-radius: 25px; text-decoration: none; font-weight: bold; font-size: 0.9em; box-shadow: 0 4px 6px rgba(118, 75, 162, 0.2);" %>
      <% else %>
        
        <% relationship = current_user.active_relationships.find_by(followed_id: @user.id) %>
        
        <% if relationship.present? %>
          <%= button_to 'フォロー解除', relationship_path(relationship), method: :delete, data: { turbo: false }, style: "background: #e5e7eb; color: #4b5563; padding: 10px 24px; border: none; border-radius: 25px; font-weight: bold;" %>
        <% else %>
          <%= button_to 'フォローする', relationships_path(followed_id: @user.id), method: :post, data: { turbo: false }, style: "background: #764ba2; color: white; padding: 10px 24px; border: none; border-radius: 25px; font-weight: bold; cursor: pointer; box-shadow: 0 4px 6px rgba(118, 75, 162, 0.2);" %>
        <% end %>
        <% if current_user.mutual_following?(@user) %>
          <%= button_tag "Dummy", type: "button", style: "background: #764ba2; color: white; padding: 10px 24px; border: none; border-radius: 25px; font-weight: bold; cursor: pointer; margin-left: 8px; box-shadow: 0 4px 6px rgba(118, 75, 162, 0.2);" %>
        <% end %>
      <% end %>
    </div>

  </div>
</div>